# Timezone
TZ=Asia/Almaty

# Parsers Hub
PARSERS_HUB_PORT=8090

# PostgreSQL (container)
POSTGRES_DB=parsers
POSTGRES_USER=parsers
POSTGRES_PASSWORD=parsers
POSTGRES_PORT=5432

# IMPORTANT: used by parsers_hub and parser jobs
DATABASE_URL=postgresql://parsers:parsers@postgres:5432/parsers

# Selenium service ports
SELENIUM_PORT=4444
SELENIUM_VNC_PORT=7900

# Redis queue
REDIS_PORT=6379

# pgAdmin (optional, only with --profile tools)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Multi-user FastAPI backend
BACKEND_PORT=8000
BACKEND_SECRET_KEY=change-this-secret-key
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_AUTO_CREATE_TABLES=false
BACKEND_CELERY_BROKER_URL=redis://redis:6379/0
BACKEND_CELERY_RESULT_BACKEND=redis://redis:6379/1
BACKEND_WORKER_CONCURRENCY=1
BACKEND_JOB_POLL_INTERVAL_SEC=2
PARSERS_HUB_INTERNAL_URL=http://parsers_hub:8090
BACKEND_FREE_PLAN_JOBS_PER_MONTH=10
BACKEND_FREE_PLAN_RECORDS_PER_MONTH=500
BACKEND_FREE_PLAN_SOURCES=olx,krisha,2gis,kolesa
PAYMENT_WEBHOOK_SECRET=change-payment-webhook-secret
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
