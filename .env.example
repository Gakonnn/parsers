# Timezone
TZ=Asia/Almaty

# Parsers Hub
PARSERS_HUB_PORT=8090

# PostgreSQL (container)
POSTGRES_DB=parsers
POSTGRES_USER=parsers
POSTGRES_PASSWORD=parsers
POSTGRES_PORT=5432

# IMPORTANT: used by parsers_hub and parser jobs
DATABASE_URL=postgresql://parsers:parsers@postgres:5432/parsers

# Optional: residential proxy channel for 2GIS only
# Example: socks5://user:pass@host:port
PARSERS_2GIS_PROXY_SERVER=
# Example: localhost;127.0.0.1
PARSERS_2GIS_PROXY_BYPASS_LIST=

# Selenium service ports
SELENIUM_PORT=4444
SELENIUM_VNC_PORT=7900

# pgAdmin (optional, only with --profile tools)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
