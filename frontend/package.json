{
  "name": "parsers-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:standalone": "HOSTNAME=0.0.0.0 PORT=3000 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
