    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
